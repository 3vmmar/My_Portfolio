# ---------------------------------------------------------------------------
# Next.js / Node
#
# This replaced a Python packaging .gitignore that shipped with the repo. That
# template ignored `lib/`, which in a Python project is a build artifact but
# here is the entire content layer (lib/content.ts, lib/projects.ts). Left as
# it was, those two files would never reach the remote and the Vercel build
# would fail on unresolved `@/lib/*` imports.
# ---------------------------------------------------------------------------

node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# Vercel
.vercel

# Environment
.env
.env*.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Testing / coverage
coverage/
.nyc_output/

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python — the skills/ tooling is Python, so keep its caches out
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local scratch
/tmp/
*.local

# The 1.4MB source photograph every colour was measured from. Kept out of the
# repo because the derived crops in public/img are what the site actually
# loads; keep a copy somewhere durable if the palette ever needs re-deriving.
/Formal mee.jpg
